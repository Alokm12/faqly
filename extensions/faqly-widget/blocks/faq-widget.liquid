{{ 'faqly-widget.css' | asset_url | stylesheet_tag }}

{% comment %}
  Faqly — FAQ Widget (Theme App Extension block)
  "Verdant"-style layout: eyebrow badge, two-part serif heading, subtitle,
  pill filter, circular +/- accordion toggles, and now a "Still have
  questions?" support CTA card at the bottom. FAQ content itself is
  fetched client-side from the App Proxy endpoint by faqly-widget.js —
  everything else here is static block-settings markup.

  Escaping: Liquid does NOT auto-escape {{ }}. Every block setting below
  is free text a merchant types in the Theme Editor and is therefore
  piped through `| escape`, including the ones that render as visible
  text rather than into an attribute. Skipping it on the text settings
  let a merchant put raw markup — including <script> — into every page
  carrying the block. It is the same trust level as editing the theme, so
  it is not a privilege escalation, but it is exactly the pattern App
  Store review flags. Leave the filters in place.
{% endcomment %}

<div
  class="faqly-widget"
  data-faqly-widget
  data-product-id="{{ product.id }}"
  data-collection-ids="{{ product.collections | map: 'id' | join: ',' }}"
  data-empty-text="{{ block.settings.empty_state_text | escape }}"
  data-loading-text="{{ block.settings.loading_text | escape }}"
  data-all-tab-label="{{ block.settings.all_tab_label | escape }}"
  data-credit-text="{{ block.settings.credit_text | escape }}"
  data-show-credit="{{ block.settings.show_credit }}"
  {{ block.shopify_attributes }}
>
  {% comment %}
    Appearance no longer comes from block settings. The custom properties
    that used to be written here are declared in faqly-widget.css instead,
    and faqly-widget.js overwrites them from the App Proxy payload once it
    lands. The stylesheet defaults are identical to the old block-schema
    defaults, so the widget paints correctly before the fetch resolves and
    there is no flash of unstyled content — only, at most, a flash of
    default-coloured content on a store that changed the accent.
  {% endcomment %}

  {% if block.settings.eyebrow_text != blank %}
    <div class="faqly-widget__eyebrow">
      <span class="faqly-widget__eyebrow-dot"></span>
      {{ block.settings.eyebrow_text | escape }}
    </div>
  {% endif %}

  {% if block.settings.title_line1 != blank or block.settings.title_accent != blank %}
    <h2 class="faqly-widget__title">
      {% if block.settings.title_line1 != blank %}
        <span class="faqly-widget__title-line">{{ block.settings.title_line1 | escape }}</span>
      {% endif %}
      {% if block.settings.title_accent != blank %}
        <span class="faqly-widget__title-accent">{{ block.settings.title_accent | escape }}</span>
      {% endif %}
    </h2>
  {% endif %}

  {% if block.settings.subtitle != blank %}
    <p class="faqly-widget__subtitle">{{ block.settings.subtitle | escape }}</p>
  {% endif %}

  {% comment %}
    The search field is built by faqly-widget.js, not here: whether it
    appears at all and what its placeholder says are app settings that
    arrive with the FAQ payload, and rendering an input in Liquid that the
    script might immediately remove would flash a control the merchant
    turned off. This is just the mount point.
  {% endcomment %}
  <div class="faqly-search" data-faqly-search hidden></div>

  <div class="faqly-pills" data-faqly-pills></div>
  <div class="faqly-widget__list" data-faqly-list>
    <p class="faqly-widget__loading">{{ block.settings.loading_text | escape }}</p>
  </div>

  {% if block.settings.show_cta %}
    <div class="faqly-cta">
      {% if block.settings.cta_icon != blank %}
        <div class="faqly-cta__icon">{{ block.settings.cta_icon | escape }}</div>
      {% endif %}
      {% if block.settings.cta_heading != blank %}
        <h3 class="faqly-cta__heading">{{ block.settings.cta_heading | escape }}</h3>
      {% endif %}
      {% if block.settings.cta_subtitle != blank %}
        <p class="faqly-cta__subtitle">{{ block.settings.cta_subtitle | escape }}</p>
      {% endif %}
      {% if block.settings.cta_primary_text != blank or block.settings.cta_secondary_text != blank %}
        <div class="faqly-cta__actions">
          {% if block.settings.cta_primary_text != blank %}
            <a
              class="faqly-cta__button faqly-cta__button--primary"
              href="{{ block.settings.cta_primary_url | default: '#' | escape }}"
            >
              {{ block.settings.cta_primary_text | escape }}
            </a>
          {% endif %}
          {% if block.settings.cta_secondary_text != blank %}
            <a
              class="faqly-cta__button faqly-cta__button--secondary"
              href="{{ block.settings.cta_secondary_url | default: '#' | escape }}"
            >
              {{ block.settings.cta_secondary_text | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

<script src="{{ 'faqly-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Faqly FAQ Widget",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header text"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow badge text",
      "default": "Help Center"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Heading (line 1)",
      "default": "Frequently asked"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Heading accent word (italic, colored)",
      "default": "questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know. Can't find an answer? Our team is always happy to help."
    },
    {
      "type": "header",
      "content": "Category filter"
    },
    {
      "type": "text",
      "id": "all_tab_label",
      "label": "\"Show all\" tab label",
      "default": "All"
    },
    {
      "type": "header",
      "content": "States"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Loading FAQs…"
    },
    {
      "type": "text",
      "id": "empty_state_text",
      "label": "Text when no FAQs apply",
      "default": "No FAQs available for this page yet."
    },
    {
      "type": "header",
      "content": "Support CTA card"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show \"Still have questions?\" card",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_icon",
      "label": "Icon (emoji)",
      "default": "💬"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "cta_subtitle",
      "label": "Subtitle",
      "default": "Our support team typically replies within a few hours on business days."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Chat with us"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary button text",
      "default": "Browse docs"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Footer credit"
    },
    {
      "type": "checkbox",
      "id": "show_credit",
      "label": "Show \"Powered by\" credit line",
      "default": true
    },
    {
      "type": "text",
      "id": "credit_text",
      "label": "Credit text",
      "default": "Powered by Faqly"
    },
    {
      "type": "header",
      "content": "Appearance",
      "info": "Accent color, font size and roundness moved to the Faqly app → Settings → Appearance, where there is a live preview and the choices survive a theme change. Nothing to set here."
    }
  ]
}
{% endschema %}
