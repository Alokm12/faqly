// Faqly data layer.
//
// ARCHITECTURE NOTE — why this file exists at all now:
// FAQs, Categories and Settings used to live *only* in Shopify
// app-reserved metaobjects ("$app:faq"). App-reserved data is owned by the
// app installation: Shopify deletes the definition and every entry inside
// it shortly after the app is uninstalled, and changing a field key/type
// in shopify.app.toml can drop values across all entries. That is why
// content kept vanishing during development.
//
// This database is now the source of truth. Metaobjects are an OPTIONAL
// write-through mirror (see app/services/metaobject-sync.server.js),
// switched on with FAQLY_METAOBJECT_MIRROR=true, and only useful if you
// later want to server-render FAQs in Liquid for SEO. The storefront
// widget reads the App Proxy, so nothing on the storefront depends on the
// mirror today.

generator client {
  provider = "prisma-client-js"
}

// DEV: sqlite, no environment variable needed.
//
// PRODUCTION: switch to managed Postgres by changing these two lines to
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// and re-running `npx prisma migrate dev --name init`. SQLite on an
// ephemeral filesystem (Fly/Render/Railway) is wiped on every redeploy,
// taking every session and every FAQ with it.
//
// The models below deliberately avoid Json columns and enums so the exact
// same file works on both engines.
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// One row per store. Uninstall marks `uninstalledAt` instead of deleting
/// anything, so a merchant who reinstalls gets all their FAQs back — a real
/// retention win over apps that start you from zero.
model Shop {
  domain        String    @id
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  lastSyncAt    DateTime?
  lastSyncError String?

  faqs       Faq[]
  categories Category[]
  setting    Setting?
}

model Category {
  id     String @id @default(cuid())
  shop   String
  /// URL-safe slug, unique per shop. Kept as the public identifier so the
  /// existing /app/categories/:handle routes and every FAQ's categoryHandle
  /// keep working unchanged.
  handle String

  name         String
  icon         String  @default("")
  iconImageUrl String  @default("")
  color        String  @default("")
  position     Int     @default(0)
  /// Storefront visibility. Previously derived from the metaobject's
  /// `publishable` capability; now an explicit column so it can't drift.
  visible      Boolean @default(true)

  /// GID of the mirrored metaobject, when the mirror is enabled. Null just
  /// means "not mirrored yet" — never a data-loss condition.
  metaobjectId String?
  syncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopRecord Shop  @relation(fields: [shop], references: [domain], onDelete: Cascade)
  faqs       Faq[]

  @@unique([shop, handle])
  @@index([shop, position])
}

model Faq {
  id     String @id @default(cuid())
  shop   String
  handle String

  question String
  answer   String
  /// "DRAFT" | "PUBLISHED" — see app/models/faq-status.js. Kept as a String
  /// rather than an enum so the schema stays sqlite-compatible.
  status   String @default("DRAFT")
  position Int    @default(0)

  categoryId String?

  /// JSON-encoded arrays of Shopify GIDs. Stored as text (not Json) for
  /// sqlite compatibility; always read/written through the helpers in
  /// Faq.server.js so callers never touch the raw string.
  productIds    String @default("[]")
  collectionIds String @default("[]")

  metaobjectId String?
  syncedAt     DateTime?

  /// "manual" | "ai" — how this FAQ came into existence. Drives the "AI"
  /// badge on the list, and makes it possible to find every generated FAQ
  /// later if a model turns out to have got something wrong.
  source String @default("manual")

  /// "high" | "medium" | "low"; null on manual FAQs. How well the grounding
  /// data supported the generated answer — "low" means the text contains a
  /// [MERCHANT: fill in] placeholder and must not be published as-is.
  aiConfidence String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopRecord Shop      @relation(fields: [shop], references: [domain], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([shop, handle])
  @@index([shop, position])
  @@index([shop, status])
  @@index([categoryId])
}

model Setting {
  shop String @id

  poweredByVisible Boolean @default(true)
  schemaEnabled    Boolean @default(false)
  feedbackEnabled  Boolean @default(false)
  analyticsEnabled Boolean @default(true)
  defaultStatus    String  @default("DRAFT")

  /// APPEARANCE — moved here from the theme app extension's block schema.
  ///
  /// Theme block settings live inside the theme's own JSON, so switching or
  /// duplicating a theme silently discards every styling choice the
  /// merchant made. Owning these here means the widget looks the same the
  /// moment a new theme goes live, and it is what lets the Appearance tab
  /// show a live preview.
  ///
  /// Every default below is byte-identical to the block-schema default it
  /// replaces, so a merchant who never touched the theme editor sees no
  /// change at all on upgrade.
  ///
  /// These reach a shopper's browser as CSS custom properties, so the
  /// colour is sanitized and the numbers clamped on write AND again on the
  /// way out — see Settings.server.js and storefront-faqs.server.js.
  accentColor  String @default("#4A5D3A")
  fontSize     Int    @default(16)
  radiusWidget Int    @default(21)
  radiusTabbar Int    @default(50)
  radiusPill   Int    @default(40)
  radiusCard   Int    @default(14)
  radiusButton Int    @default(8)
  radiusIcon   Int    @default(50)

  /// Storefront search. `searchEnabled` gates the input entirely; the
  /// placeholder is merchant free text and is escaped at the point it
  /// becomes DOM, never interpolated into HTML.
  searchEnabled     Boolean @default(true)
  searchPlaceholder String  @default("Search for answers…")

  updatedAt DateTime @updatedAt

  shopRecord Shop @relation(fields: [shop], references: [domain], onDelete: Cascade)
}

/// Per-shop AI plan and credit balance.
///
/// DELIBERATELY NOT RELATED TO `Shop`. Uninstall never deletes a Shop row (it
/// sets `uninstalledAt`), so a cascade would never fire anyway — and keeping
/// this standalone means the credit balance survives any future change to how
/// shop rows are reaped.
///
/// Credits reset lazily: the quota check compares `cycleResetAt` against now
/// and rolls the window forward when it has passed. No cron job, so nothing
/// silently stops resetting when a scheduler dies.
model ShopPlan {
  shop           String   @id
  /// free | pro | advanced. Seeded manually for now.
  plan           String   @default("free")
  aiCreditsUsed  Int      @default(0)
  aiCreditsLimit Int      @default(5)
  cycleResetAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One row per Anthropic API call, success or failure.
///
/// Append-only, and independent of the Shop lifecycle for the same reason as
/// ShopPlan: this is the audit trail for what the app spent on a merchant's
/// behalf, and it should outlive any row it describes.
model AiUsage {
  id String @id @default(cuid())

  shop    String
  /// "generate" | "assist"
  feature String
  /// The model ID as sent, so a later model swap stays traceable.
  model   String

  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  success   Boolean @default(true)
  /// Machine-readable failure reason: QUOTA_EXCEEDED, AI_TIMEOUT,
  /// AI_INVALID_JSON, AI_UNAVAILABLE. Null on success.
  errorCode String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
